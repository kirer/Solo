{
	"name": "solo",
	"version": "2.3.5",
	"private": true,
	"type": "module",
	"main": "desktop/dist/main.js",
	"description": "Solo：一个人 + 一个 AI 组织的多 agent 运行时（提示词、能力、记忆全部落盘）",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node --experimental-strip-types src/shell/main.ts",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p desktop/tsconfig.json --noEmit && tsc -p ui/app/tsconfig.json --noEmit && npm run check:boundaries",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"live": "node --experimental-strip-types scripts/core-live.ts",
		"live:scenarios": "node --experimental-strip-types scripts/scenario-live.ts",
		"prompt:check": "node --experimental-strip-types scripts/prompt-check.ts",
		"update:serve": "node --experimental-strip-types scripts/update-server.ts",
		"update:key": "node --experimental-strip-types scripts/update-key.ts",
		"update:manifest": "node --experimental-strip-types scripts/update-manifest.ts",
		"desktop:build": "tsc -p desktop/tsconfig.json",
		"desktop:dev": "npm run desktop:build && electron .",
		"desktop:pack": "npm run desktop:build && electron-builder --dir --publish never",
		"desktop:dist:mac": "npm run desktop:build && electron-builder --mac --arm64 --publish never",
		"desktop:dist:win": "npm run desktop:build && electron-builder --win --x64 --publish never",
		"ui:build": "vite build --config ui/app/vite.config.ts",
		"ui:typecheck": "tsc -p ui/app/tsconfig.json --noEmit"
	},
	"dependencies": {
		"@dicebear/collection": "^9.4.2",
		"@dicebear/core": "^9.4.3",
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-schema": "1.5.0",
		"sherpa-onnx-node": "^2.0.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.7.0",
		"electron": "^44.10.1",
		"electron-builder": "^26.18.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "5.9.3",
		"vite": "^6.4.5",
		"vitest": "4.1.12"
	}
}
