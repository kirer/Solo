{
	"name": "ai-company",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "一人公司：一个老板 + 一个 AI 组织的多 agent 运行时（提示词、能力、记忆全部落盘）",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node --experimental-strip-types src/core/shell/main.ts",
		"check": "tsc -p tsconfig.json --noEmit && npm run check:boundaries",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"live": "node --experimental-strip-types scripts/core-live.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	}
}
